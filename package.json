{
  "name": "desasa",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json && vite build",
    "preview": "wrangler pages dev dist",
    "dev:full": "npm run build && wrangler pages dev dist",
    "lint": "eslint src functions tests vite.config.ts drizzle.config.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply webdesa --local",
    "cf:typegen": "wrangler types --env-interface CloudflareBindings",
    "cf:build": "wrangler pages functions build --outdir .wrangler/test-worker --compatibility-date 2026-11-06 --compatibility-flags nodejs_compat",
    "db:convert": "node scripts/convert-postgres.mjs",
    "pretest": "npm run cf:build",
    "deploy:staging": "wrangler pages deploy dist --project-name webdesa-cloudflare-staging --branch migration/cloudflare"
  },
  "dependencies": {
    "@fontsource/geist": "^5.2.6",
    "@fontsource/geist-mono": "^5.2.6",
    "@hookform/resolvers": "^5.1.1",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@tiptap/extension-image": "^3.0.7",
    "@tiptap/pm": "^3.0.7",
    "@tiptap/react": "^3.0.7",
    "@tiptap/starter-kit": "^3.0.7",
    "@uiw/react-md-editor": "^4.0.8",
    "bcryptjs": "^3.0.2",
    "better-auth": "1.7.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.525.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-google-recaptcha": "^3.1.0",
    "react-hook-form": "^7.60.0",
    "react-router-dom": "^7.9.5",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-google-recaptcha": "^2.1.9",
    "@vitejs/plugin-react": "^5.1.0",
    "drizzle-kit": "^0.31.6",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^5.2.0",
    "miniflare": "^5.20261104.0-beta",
    "tailwindcss": "^4.0.0",
    "typescript": "^5",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.47.0"
  },
  "type": "module"
}
