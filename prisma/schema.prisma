// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  posts         Post[]
  accounts      Account[]
  sessions      Session[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verificationtokens")
}

enum UserRole {
  USER
  ADMIN
}

model Post {
  id          String   @id @default(cuid())
  title       String
  content     String?
  published   Boolean  @default(false)
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  
  @@map("posts")
}

model HeaderSettings {
  id        String   @id @default(cuid())
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations
  navigationItems NavigationItem[]
  
  @@map("header_settings")
}

model NavigationItem {
  id               String         @id @default(cuid())
  label            String
  href             String
  order            Int
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  
  // Relations
  headerSettingsId String
  headerSettings   HeaderSettings @relation(fields: [headerSettingsId], references: [id], onDelete: Cascade)
  
  @@map("navigation_items")
}

model HeroSlide {
  id          String   @id @default(cuid())
  title       String
  description String
  imageUrl    String
  order       Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@map("hero_slides")
}

model VillageInfo {
  id          String   @id @default(cuid())
  visi        String   @db.Text
  misi        String   @db.Text
  tujuan      String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@map("village_info")
}

model VillageHeadWelcome {
  id        String   @id @default(cuid())
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("village_head_welcome")
}

model PopulationData {
  id                   String   @id @default(cuid())
  totalPopulation      Int
  malePopulation       Int
  femalePopulation     Int
  households           Int
  temporaryResidents   Int
  populationMutations  Int
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("population_data")
}

model Employee {
  id          String   @id @default(cuid())
  name        String
  position    String   // jabatan
  photoUrl    String?
  order       Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@map("employees")
}

model Helpdesk {
  id                String   @id @default(cuid())
  nama              String
  nomorWhatsapp     String
  kategoriPengaduan String   // umum, kesehatan, keamanan, kebersihan
  pesanPengaduan    String   @db.Text
  status            String   @default("pending") // pending, in_progress, resolved, closed
  response          String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@map("helpdesk")
}

model Info {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  pdfUrl    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("info")
}

model Gallery {
  id          String   @id @default(cuid())
  title       String
  description String?
  imageUrl    String
  category    String?  // kategori kegiatan
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@map("gallery")
}

model ApbDesa {
  id              String   @id @default(cuid())
  year            Int      // tahun APB
  pendapatanDesa  Decimal  @db.Decimal(15,2) // pendapatan desa
  belanjaDesa     Decimal  @db.Decimal(15,2) // belanja desa
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@unique([year])
  @@map("apb_desa")
}
